# Copy to .env (local / ECS) or .dev.vars (wrangler dev). Never commit the real file.
JWT_SECRET=change-me-to-a-long-random-string
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: JSearch on RapidAPI adds Google-for-Jobs results incl. Malaysia
RAPIDAPI_KEY=
# Comma-separated emails that become admins when they sign up / sign in
ADMIN_EMAILS=you@example.com
# Node/ECS only
PORT=8787
DB_PATH=./data/airesume.db
